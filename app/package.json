{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-with-deploy-time.mjs",
    "start": "npm run build && next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run build && npm test && npm run lint",
    "wacom:sync": "node scripts/sync-wacom-sdk.mjs",
    "db:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:normalize-patient-names": "dotenv -e .env.local -- tsx scripts/normalize-patient-names.ts",
    "db:cleanup-duplicate-patients": "dotenv -e .env.local -- tsx scripts/cleanup-duplicate-patients.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/render": "^2.0.8",
    "@stackframe/stack": "^2.8.85",
    "@types/pg": "^8.15.6",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "marked": "^17.0.1",
    "next": "^16.0.7",
    "next-intl": "^4.5.6",
    "pg": "^8.16.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "resend": "^6.1.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "optionalDependencies": {
    "@wacom/signature-sdk": "^2.1.1"
  },
  "devDependencies": {
    "@prisma/dev": "^0.24.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "prisma": "^7.8.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "@mrleebo/prisma-ast": "0.15.0",
    "effect": "3.21.0",
    "hono": "4.12.12",
    "path-to-regexp": "6.3.0",
    "esbuild": "0.25.0",
    "lucide-react": "0.563.0",
    "lodash-es": "4.18.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
